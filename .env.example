# Скопируйте в .env.local и заполните: этот файл читает только сервер разработки.
# В бандл ключи не попадают — префикса VITE_ у них нет.

# Локальный сервис входа и адрес Vite, который должен совпадать с IDENTITY_WEB_ORIGIN.
IDENTITY_URL=http://127.0.0.1:8084
AUTH_WEB_ORIGIN=http://localhost:5173

# Адрес помощника «Мой ТПУ» (assistant), без слэша на конце.
# Например: http://127.0.0.1:8787 или https://assistant.example.tpu.ru
ASSISTANT_URL=
ASSISTANT_SESSION_AUTH=false

# Клиентский ключ чата (X-Assistant-Key). Просьба к владельцу стенда — не коммитьте значение.
ASSISTANT_KEY=
